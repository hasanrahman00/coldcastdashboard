# Base URL of the Coldcast SCRAPER API (the contacout_lusha_salesql_multiuser
# backend) — jobs / profiles / scrape status.
# Local dev:   http://localhost:3003
# Production:  https://your-scraper-host
VITE_API_URL=http://localhost:3003

# Base URL of Coldcast CORE — the central auth + billing + admin service shared by
# every product. The dashboard sends login / me / key / trial / admin calls here.
# Leave BLANK to keep the old single-host behavior (auth falls back to VITE_API_URL).
# Production:  https://core.coldcast.io
VITE_CORE_URL=

# Optional: hosted .zip download link for the Chrome extension.
# Leave blank to disable the "Get extension" button until you have a URL.
VITE_EXT_DOWNLOAD_URL=

# ── Free-account dispenser (api/free-account.js — SERVER-SIDE only) ───────────
# Powers the serverless function, NOT the browser. MongoDB holds the accounts.
# Reuse your Atlas cluster (a new "freeAccounts" collection). The URI is a secret
# — in production set these in the Vercel project's Environment Variables.
# Import accounts:  node scripts/import-accounts.mjs lusha "path\to\lusha.csv"
MONGODB_URI=mongodb+srv://USER:PASS@your-cluster.mongodb.net
MONGODB_DB=cold_cast_free_accounts

# Used by the serverless function to verify the caller is a logged-in user
# (validates their Bearer token against <BACKEND_URL>/api/auth/me). Point this at
# CORE — the identity authority the dashboard logs in against. FAIL-CLOSED: if
# blank the endpoint DENIES every request unless you also set
# FREE_ACCOUNT_ALLOW_INSECURE=1 (local dev only). Keep it set in production.
BACKEND_URL=https://core.coldcast.io
# FREE_ACCOUNT_ALLOW_INSECURE=1   # dev only: allow calls when BACKEND_URL is blank
