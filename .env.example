# ═══════════════════════════════════════════════════════════════════════════
#  Coldcast dashboard — environment
#  Frontend vars (VITE_*) are PUBLIC — Vite bakes them into the client bundle.
#  Server-side vars (api/ functions) are secrets — set them in Vercel, NOT here.
# ═══════════════════════════════════════════════════════════════════════════

# ── Frontend (Vite — public, shipped in the browser bundle) ─────────────────
# Which scraper + Core this dashboard talks to. Per-environment values live in
# .env.development (local dev) and .env.production (deploy) — see those files.
VITE_SALESNAV_SCRAPER_URL=https://salesnav.coldcast.io   # scraper: jobs / profiles / live SSE
VITE_CORE_URL=https://core.coldcast.io          # Core: login / billing / admin
VITE_EXT_STORE_URL=                              # Chrome Web Store listing link (optional; overrides default)

# ── Serverless functions (api/, server-side only — set these in Vercel) ─────
# /api/free-account dispenses pooled enrichment accounts to logged-in users.
CORE_BACKEND_URL=https://core.coldcast.io       # validates the user's Bearer token here (fail-closed)
# The lusha/salesql/contactout free-LOGIN pool (its own cluster, NOT the app DB). The old
# MONGODB_URI still works as a fallback during the Vercel rename. DB name is fixed via the
# code default (cold_cast_free_accounts), so only the URI var below is needed.
MONGODB_COLDCAST_FREE_LUSHA_CONTACTOUT_SALESQL_SERPER_ACCOUNTS=   # free-login pool cluster — SECRET, set in Vercel env vars
# FREE_ACCOUNT_ALLOW_INSECURE=1                  # LOCAL DEV ONLY — auto-disabled in production
